    _rel_last_speaker = None

    def _rel_speaker_key(who):
        if not isinstance(who, str):
            return None
        try:
            _pn = renpy.store.player_name
        except Exception:
            _pn = None
        if _pn is not None and who == _pn:
            return "MC"
        if who in ("You", "你"):
            return "MC"
        for key, aliases in _rel_name_map.items():
            if who in aliases:
                return key
        return None

