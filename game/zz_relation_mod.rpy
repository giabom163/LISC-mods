        items = cond if isinstance(cond, list) else [cond]
        for it in items:
            if isinstance(it, tuple) and len(it) == 2 and it[0] == "prev":
                if last_speaker != it[1]:
                    return False
            elif isinstance(it, tuple) and len(it) == 2 and it[0] == "not":
                words = it[1] if isinstance(it[1], list) else [it[1]]
                if any(w in what for w in words):
                    return False
            else:
                if isinstance(it, str) and it not in what:
                    return False
        return True

    def _rel_apply(who, what):
        global _rel_last_speaker
        if not isinstance(what, str):
            return what
        key = _rel_speaker_key(who)
        old_what = what
        # 保护“男朋友/女朋友”，避免被“朋友”规则误伤
        what = what.replace("男朋友", "\x01\u7537\x01").replace("女朋友", "\x01\u5973\x01")
        if key is not None:
            for speaker, old, new, cond in _rel_rules:
                if speaker != key:
                    continue
                if not old or not new:
                    continue
                if cond and not _rel_cond_ok(cond, _rel_last_speaker, what):
                    continue
                if old in what:
                    what = what.replace(old, new)
        for old, new in _rel_global_rules:
            if old and new and old in what:
                what = what.replace(old, new)
        # 兜底：任何漏网的“朋友”一律换成“伙伴”，保证全文不再出现
        if "朋友" in what:
            what = what.replace("朋友", "伙伴")
        what = what.replace("\x01\u7537\x01", "男朋友").replace("\x01\u5973\x01", "女朋友")
        if what != old_what and _rel_log_enabled:
            try:
                with open(renpy.config.gamedir + "/relation_mod_log.txt", "a", encoding="utf-8") as _f:
                    _f.write("%s | %s => %s\n" % (who, old_what, what))
            except Exception:
                pass
        _rel_last_speaker = key
        return what

    def _rel_global_filter(text):
        if not isinstance(text, str) or "朋友" not in text:
            return text
        text = text.replace("男朋友", "\x01\u7537\x01").replace("女朋友", "\x01\u5973\x01")
        text = text.replace("朋友", "伙伴")
        text = text.replace("\x01\u7537\x01", "男朋友").replace("\x01\u5973\x01", "女朋友")
        return text

    # 全局兜底：对话之外的文本（菜单选项、手机界面等）也不会再出现“朋友”
    config.replace_text = _rel_global_filter



# ============================================================================
# 重新定义对话界面：显示前先按说话人过滤
# （与原版界面一模一样，只是开头多了一行 $ what = _rel_apply(who, what)）
# ============================================================================
screen say(who, what):

    $ what = _rel_apply(who, what)

    window:
        id "window"
        if persistent.dialogue_background:
            add "gui/namebox.png"
        else:
            background None

        if who is not None:

            window:
                id "namebox"
                style "namebox"
                text who id "who"

        text what id "what"

    ## 侧图像（保持原样）
    if not renpy.variant("small"):
        add SideImage() xalign 0.0 yalign 1.0
